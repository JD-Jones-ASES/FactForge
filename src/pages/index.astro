---
import Layout from '../layouts/Layout.astro';
import { listPacks } from '../lib/engine/registry';
import { withBase } from '../lib/basePath';

const packs = listPacks();

/** Stable band order for hub sections */
const BAND_ORDER = [
  'Arithmetic',
  'Fractions',
  'Number structure',
  'Proportional',
  'Algebra',
  'Geometry',
];

const byBand = new Map<string, typeof packs>();
for (const pack of packs) {
  const list = byBand.get(pack.band) ?? [];
  list.push(pack);
  byBand.set(pack.band, list);
}

const orderedBands = [
  ...BAND_ORDER.filter((b) => byBand.has(b)),
  ...[...byBand.keys()].filter((b) => !BAND_ORDER.includes(b)),
];
---

<Layout title="FactForge — math packs">
  <section class="hero">
    <h1>Find the missing fact</h1>
    <p>
      Modular drills over relations: given most of the story, supply the rest.
      Equivalent answers count; unreduced fractions get a gentle nudge unless
      reducing is the point.
    </p>
    <p class="hint-text" style="margin-top: 0.75rem;">
      <a href={withBase('/builder')}>Builder</a>
      {' '}— snap knobs into a shareable play link (static, no account).
    </p>
  </section>

  {
    orderedBands.map((band) => (
      <section class="band-section" aria-labelledby={`band-${band.replace(/\s+/g, '-').toLowerCase()}`}>
        <h2 class="band-heading" id={`band-${band.replace(/\s+/g, '-').toLowerCase()}`} data-band={band}>
          {band}
        </h2>
        <div class="pack-grid" aria-label={`${band} packs`}>
          {byBand.get(band)!.map((pack) => (
            <a
              class="pack-card"
              href={withBase(`/play/${pack.id}`)}
              data-pack={pack.id}
            >
              <span class="pack-band">{pack.band}</span>
              <h3>{pack.title}</h3>
              <p>{pack.blurb}</p>
              <span class="pack-go">Play →</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
